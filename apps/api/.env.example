# Environment
# ===========
# IMPORTANT: Copy this to .env and fill in real values.
# NEVER commit real secrets.

# Application
APP_NAME=ExamPlatform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://examplatform:devpassword123@localhost:5432/examplatform
DATABASE_URL_SYNC=postgresql://examplatform:devpassword123@localhost:5432/examplatform

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# Admin Bootstrap (DEV ONLY — disable in production)
BOOTSTRAP_ADMIN_EMAIL=admin@examplatform.dev
BOOTSTRAP_ADMIN_PASSWORD=Admin@Dev123
