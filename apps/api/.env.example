# Copy to .env for local development. Use secret manager values in hosted environments.
APP_NAME=ExamPlatform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local development uses SQLite. Production must use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./examplatform.db
DATABASE_URL_SYNC=sqlite:///./examplatform.db
# For managed PostgreSQL migrations, install requirements-dev.txt and use:
# DATABASE_URL_SYNC=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# Shared Redis is required in production for token revocation and rate limiting.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=15

# Optional until Razorpay test credentials and a webhook are configured.
# Keep these server-only; never prefix them with NEXT_PUBLIC_.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
